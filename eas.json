{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_USAR_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://fulbito-api.taild5debe.ts.net:8443"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_USAR_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://fulbito-api.taild5debe.ts.net:8443"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_USAR_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://fulbito-api.taild5debe.ts.net:8443"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
