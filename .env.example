# Copiá este archivo como .env.local y completá la URL de la API.
# .env.local está en .gitignore.

# false = usa la API real; true (o vacío) = usa los mocks locales.
EXPO_PUBLIC_USAR_MOCKS=false

# API desplegada y expuesta a internet por Cloudflare Tunnel (Dokploy, server1):
EXPO_PUBLIC_API_URL=https://fulbito-api.taild5debe.ts.net:8443

# En la computadora: http://localhost:3000
# En el teléfono con Expo Go: la IP de la computadora en la misma wifi,
# por ejemplo http://192.168.0.10:3000.
# En la red local del server: http://192.168.0.178:3100
