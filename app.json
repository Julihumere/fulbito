{
  "expo": {
    "name": "Fulbito!",
    "slug": "fulbito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.gob.villaguay.fulbito"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ar.gob.villaguay.fulbito"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "@react-native-vector-icons/ionicons",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E7D32",
          "dark": {
            "backgroundColor": "#103B1C"
          },
          "image": "./assets/splash-icon.png",
          "imageWidth": 280
        }
      ],
      "expo-status-bar",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear el código QR de las reservas en la puerta de la cancha.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tu ubicación se usa sólo para mostrarte qué complejo te queda más cerca."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La galería se usa para subir fotos del estado de una cancha.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID se usa para confirmar que sos el encargado antes de escanear ingresos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      "react-native-maps",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "scheme": "fulbito",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "5875409d-72ce-4550-aedf-249cc4036c13"
      }
    }
  }
}
